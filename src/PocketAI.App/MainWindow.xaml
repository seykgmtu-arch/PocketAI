<Window x:Class="PocketAI.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PocketAI.App.ViewModels"
        Title="Pocket AI"
        Width="1260" Height="820"
        MinWidth="980" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <DataTemplate DataType="{x:Type vm:ChatBubbleViewModel}">
            <Grid Margin="0,6">
                <Border x:Name="Bubble"
                        MaxWidth="760"
                        CornerRadius="12"
                        Padding="14,11">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="HorizontalAlignment" Value="Left" />
                            <Setter Property="Background" Value="{StaticResource AssistantBubbleBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="Background" Value="{StaticResource UserBubbleBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Content}"
                               TextWrapping="Wrap"
                               FontSize="15"
                               LineHeight="22" />
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Pocket AI" FontSize="27" FontWeight="Bold" />
                <TextBlock Text="Private local AI · Milestone 2 · Models + Knowledge + Diagnostics"
                           Foreground="{StaticResource MutedTextBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>
            <Border Grid.Column="1"
                    Background="#123427"
                    CornerRadius="999"
                    Padding="12,7"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,7,0" />
                    <TextBlock Text="{Binding StatusText}" Foreground="#C9FBE6" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Этот компьютер"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,14" />

                        <TextBlock Text="CPU" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                        <TextBlock Text="{Binding CpuText}" TextWrapping="Wrap" Margin="0,4,0,12" />

                        <TextBlock Text="GPU" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                        <TextBlock Text="{Binding GpuText}" TextWrapping="Wrap" Margin="0,4,0,12" />

                        <TextBlock Text="Память" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                        <TextBlock Text="{Binding MemoryText}" TextWrapping="Wrap" Margin="0,4,0,12" />

                        <TextBlock Text="Inference" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                        <TextBlock Text="{Binding BackendText}" Margin="0,4,0,14" FontWeight="SemiBold" />

                        <Border Background="#0E1728" CornerRadius="10" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="🔒 Локальный режим" FontWeight="SemiBold" />
                                <TextBlock Text="Inference идёт через 127.0.0.1. Интернет для модели не используется."
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>

                        <Separator Background="{StaticResource PanelBorderBrush}" Margin="0,0,0,14" />

                        <TextBlock Text="Модель"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ModelStatusText}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,8" />

                        <ComboBox ItemsSource="{Binding Models}"
                                  SelectedItem="{Binding SelectedModel}"
                                  DisplayMemberPath="Label"
                                  MinHeight="32"
                                  Margin="0,0,0,8" />

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="Обновить"
                                    Command="{Binding RefreshModelsCommand}"
                                    Padding="10,7"
                                    Background="#334155" />
                            <Button Grid.Column="2"
                                    Content="Применить"
                                    Command="{Binding ApplyModelCommand}"
                                    Padding="10,7" />
                        </Grid>

                        <Separator Background="{StaticResource PanelBorderBrush}" Margin="0,0,0,14" />

                        <TextBlock Text="Локальная база знаний"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding KnowledgeStatusText}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,4,0,8" />

                        <CheckBox Content="Использовать RAG в ответах"
                                  IsChecked="{Binding UseKnowledge}"
                                  Margin="0,0,0,10" />

                        <Button Content="Добавить документы"
                                Command="{Binding AddKnowledgeCommand}"
                                Padding="10,7"
                                Margin="0,0,0,7" />

                        <Button Content="Очистить индекс"
                                Command="{Binding ClearKnowledgeCommand}"
                                Padding="10,7"
                                Background="#475569"
                                Margin="0,0,0,16" />

                        <TextBlock Text="Поддержка: TXT, MD, CSV, JSON, LOG, CS, DOCX. PDF будет добавлен отдельным модулем."
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,-8,0,16" />

                        <Separator Background="{StaticResource PanelBorderBrush}" Margin="0,0,0,14" />

                        <TextBlock Text="Диагностика для ChatGPT"
                                   FontSize="16"
                                   FontWeight="SemiBold" />

                        <TextBlock Text="{Binding DiagnosticStatusText}"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   MaxHeight="58"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,4,0,8" />

                        <Button Content="Создать диагностический ZIP"
                                Command="{Binding CreateDiagnosticReportCommand}"
                                Padding="10,7"
                                Margin="0,0,0,7" />

                        <Button Content="Открыть папку diagnostics"
                                Command="{Binding OpenDiagnosticsFolderCommand}"
                                Padding="10,7"
                                Background="#334155" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#3A1D1D"
                        BorderBrush="#7F1D1D"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12"
                        Margin="0,0,0,12"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" Foreground="#FECACA" />
                </Border>

                <Border Grid.Row="1"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="12">
                    <ListBox x:Name="ChatList"
                             ItemsSource="{Binding Messages}"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource TextBrush}"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </Border>

                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,5"
                            Margin="0,0,10,0">
                        <TextBox x:Name="PromptBox"
                                 Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 Foreground="{StaticResource TextBrush}"
                                 BorderThickness="0"
                                 FontSize="15"
                                 AcceptsReturn="True"
                                 MinHeight="42"
                                 MaxHeight="110"
                                 VerticalScrollBarVisibility="Auto"
                                 TextWrapping="Wrap"
                                 PreviewKeyDown="PromptBox_OnPreviewKeyDown" />
                    </Border>

                    <Button Grid.Column="1"
                            Content="Остановить"
                            Command="{Binding CancelCommand}"
                            Background="#7F1D1D"
                            Margin="0,0,8,0" />
                    <Button Grid.Column="2"
                            Content="Отправить"
                            Command="{Binding SendCommand}" />
                </Grid>

                <Border Grid.RowSpan="3"
                        Background="#CC0B1020"
                        CornerRadius="14"
                        Visibility="{Binding IsInitializing, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="380">
                        <ProgressBar IsIndeterminate="True" Height="5" Margin="0,0,0,18" />
                        <TextBlock Text="Настраиваем Pocket AI"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
