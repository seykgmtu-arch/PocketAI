<UserControl x:Class="PocketAI.App.Views.ImageGeneratorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="390"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="AI Drawing Generator"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Полностью локальный режим PocketAI · Perchance-style UI"
                               Margin="0,4,0,14"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"/>

                    <Border Background="#101A2E"
                            CornerRadius="10"
                            Padding="10"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{Binding BackendText}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding StatusText}"
                                       Margin="0,5,0,0"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Description"
                               FontWeight="SemiBold"/>
                    <TextBox Text="{Binding Prompt,UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="105"
                             MaxHeight="190"
                             Margin="0,6,0,12"
                             Padding="9"
                             Background="#0E1728"
                             Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource PanelBorderBrush}"/>

                    <TextBlock Text="Anti-Description"
                               FontWeight="SemiBold"/>
                    <TextBox Text="{Binding NegativePrompt,UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="72"
                             MaxHeight="125"
                             Margin="0,6,0,12"
                             Padding="9"
                             Background="#0E1728"
                             Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource PanelBorderBrush}"/>

                    <TextBlock Text="Art Style"
                               FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding Styles}"
                              SelectedItem="{Binding SelectedStyle}"
                              DisplayMemberPath="Name"
                              Margin="0,6,0,12"/>

                    <TextBlock Text="Model profile"
                               FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding Profiles}"
                              SelectedItem="{Binding SelectedProfile}"
                              DisplayMemberPath="Name"
                              Margin="0,6,0,12"/>

                    <TextBlock Text="Быстрый размер"
                               FontWeight="SemiBold"/>
                    <WrapPanel Margin="0,6,0,10">
                        <Button Content="512²"
                                Command="{Binding Set512Command}"
                                Margin="0,0,6,6"
                                Padding="9,6"/>
                        <Button Content="768²"
                                Command="{Binding Set768Command}"
                                Margin="0,0,6,6"
                                Padding="9,6"/>
                        <Button Content="1024²"
                                Command="{Binding Set1024Command}"
                                Margin="0,0,6,6"
                                Padding="9,6"/>
                        <Button Content="16:9"
                                Command="{Binding SetLandscapeCommand}"
                                Margin="0,0,6,6"
                                Padding="9,6"/>
                        <Button Content="9:16"
                                Command="{Binding SetPortraitCommand}"
                                Margin="0,0,6,6"
                                Padding="9,6"/>
                    </WrapPanel>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Width"/>
                            <TextBox Text="{Binding WidthText,UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,4,0,0"
                                     Padding="7"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Height"/>
                            <TextBox Text="{Binding HeightText,UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,4,0,0"
                                     Padding="7"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Seed (-1 = random)"/>
                            <TextBox Text="{Binding SeedText,UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,4,0,0"
                                     Padding="7"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Steps"/>
                            <TextBox Text="{Binding StepsText,UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,4,0,0"
                                     Padding="7"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="CFG scale"/>
                            <TextBox Text="{Binding CfgScaleText,UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,4,0,0"
                                     Padding="7"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Images"/>
                            <ComboBox ItemsSource="{Binding BatchSizes}"
                                      SelectedItem="{Binding BatchSize}"
                                      Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="✨ GENERATE"
                                Command="{Binding GenerateCommand}"
                                Padding="18,10"
                                Margin="0,0,8,0"/>
                        <Button Content="Стоп"
                                Command="{Binding StopCommand}"
                                Background="#7F1D1D"
                                Margin="0,0,8,0"/>
                        <Button Content="Папка"
                                Command="{Binding OpenImagesFolderCommand}"
                                Background="#334155"/>
                    </StackPanel>

                    <Button Content="Проверить / запустить sd-server.exe"
                            Command="{Binding CheckServerCommand}"
                            Margin="0,9,0,0"
                            Background="#475569"/>

                    <Border Background="#3A1D1D"
                            BorderBrush="#7F1D1D"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="9"
                            Margin="0,12,0,0"
                            Visibility="{Binding HasError,Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding ErrorText}"
                                   TextWrapping="Wrap"
                                   Foreground="#FECACA"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="2"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="12">
            <Grid>
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="Предпросмотр"
                               HorizontalAlignment="Center"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock Text="После генерации изображение появится здесь"
                               Margin="0,8,0,0"
                               Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>

                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasLastImage,Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <Image Source="{Binding LastImagePath}"
                               Stretch="Uniform"
                               MaxHeight="620"/>
                        <TextBlock Text="{Binding LastImagePath}"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Margin="0,10,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
