<UserControl x:Class="PocketAI.App.Views.ControlCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="🛠 Control Center"
                           FontSize="24"
                           FontWeight="Bold"/>

                <TextBlock Text="Состояние модулей, version-lock, runtime, модели, снимки и безопасная диагностика."
                           Margin="0,5,0,0"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedTextBrush}"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="Обновить"
                    Click="Refresh_OnClick"
                    Padding="14,7"
                    VerticalAlignment="Center"/>
        </Grid>

        <Border Grid.Row="1"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12"
                Margin="0,0,0,10">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Margin="0,0,12,0">
                    <TextBlock Text="Система"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="{Binding HardwareText}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource MutedTextBrush}"/>

                    <TextBlock Text="{Binding DiskText}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource MutedTextBrush}"/>

                    <TextBlock Text="{Binding RootText}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Version lock"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="{Binding VersionLockText}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource MutedTextBrush}"/>

                    <TextBlock Text="{Binding LastActionText}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Foreground="#C9FBE6"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="8">

            <DataGrid ItemsSource="{Binding Modules}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      Background="Transparent"
                      BorderThickness="0"
                      Foreground="{StaticResource TextBrush}"
                      RowBackground="Transparent"
                      AlternatingRowBackground="#0E1728"
                      HorizontalGridLinesBrush="{StaticResource PanelBorderBrush}">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Модуль"
                                        Binding="{Binding Module}"
                                        Width="130"/>

                    <DataGridTextColumn Header="Состояние"
                                        Binding="{Binding State}"
                                        Width="145"/>

                    <DataGridTextColumn Header="Runtime"
                                        Binding="{Binding Runtime}"
                                        Width="200"/>

                    <DataGridTextColumn Header="Модель"
                                        Binding="{Binding Model}"
                                        Width="200"/>

                    <DataGridTextColumn Header="Подробности"
                                        Binding="{Binding Details}"
                                        Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="3"
                Background="#0E1728"
                CornerRadius="12"
                Padding="10"
                Margin="0,10,0,0">

            <WrapPanel>
                <Button Content="📸 Снимок конфигурации"
                        Click="Snapshot_OnClick"
                        Margin="0,0,7,7"
                        Padding="10,6"/>

                <Button Content="🧾 ZIP Control Center"
                        Click="Report_OnClick"
                        Margin="0,0,7,7"
                        Padding="10,6"/>

                <Button Content="🛑 STOP AI workers"
                        Click="StopWorkers_OnClick"
                        Background="#7F1D1D"
                        Margin="0,0,7,7"
                        Padding="10,6"/>

                <Button Content="Открыть logs"
                        Click="OpenLogs_OnClick"
                        Background="#334155"
                        Margin="0,0,7,7"
                        Padding="10,6"/>

                <Button Content="Открыть snapshots"
                        Click="OpenSnapshots_OnClick"
                        Background="#334155"
                        Margin="0,0,7,7"
                        Padding="10,6"/>

                <Button Content="Version lock"
                        Click="OpenVersionLock_OnClick"
                        Background="#334155"
                        Margin="0,0,7,7"
                        Padding="10,6"/>

                <Button Content="Diagnostics"
                        Click="OpenDiagnostics_OnClick"
                        Background="#334155"
                        Margin="0,0,7,7"
                        Padding="10,6"/>
            </WrapPanel>
        </Border>

        <Border Grid.RowSpan="4"
                Background="#CC0B1020"
                CornerRadius="12"
                Visibility="{Binding BusyVisibility}">

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True"
                             Width="300"
                             Height="5"/>

                <TextBlock Text="Control Center выполняет проверку…"
                           Margin="0,12,0,0"
                           FontWeight="SemiBold"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
