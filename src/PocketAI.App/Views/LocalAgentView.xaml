<UserControl x:Class="PocketAI.App.Views.LocalAgentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,10">
            <TextBlock Text="🤖 Local Agent / Workflows"
                       FontSize="24"
                       FontWeight="Bold"/>

            <TextBlock Text="Локальные цепочки операций с файлами. v1 работает без удаления и перемещения исходников."
                       Margin="0,5,0,0"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource MutedTextBrush}"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12"
                Margin="0,0,0,10">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Рабочая папка"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               FontWeight="SemiBold"/>

                    <TextBox Grid.Column="1"
                             Text="{Binding WorkspacePath, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="30"
                             VerticalContentAlignment="Center"/>

                    <Button Grid.Column="2"
                            Content="Выбрать…"
                            Click="ChooseWorkspace_OnClick"
                            Margin="8,0,0,0"
                            Padding="10,5"/>
                </Grid>

                <Grid Grid.Row="1"
                      Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Задача"
                               VerticalAlignment="Top"
                               Margin="0,5,10,0"
                               FontWeight="SemiBold"/>

                    <TextBox Grid.Column="1"
                             Text="{Binding Instruction, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="66"
                             MaxHeight="110"
                             VerticalScrollBarVisibility="Auto"/>
                </Grid>

                <WrapPanel Grid.Row="2"
                           Margin="0,10,0,0">
                    <Button Content="1. Составить план"
                            Click="BuildPlan_OnClick"
                            Margin="0,0,7,0"
                            Padding="11,6"/>

                    <Button Content="2. Выполнить"
                            Click="Execute_OnClick"
                            Margin="0,0,7,0"
                            Padding="11,6"
                            Background="#166534"/>

                    <Button Content="Стоп"
                            Click="Stop_OnClick"
                            Margin="0,0,7,0"
                            Padding="11,6"
                            Background="#7F1D1D"/>

                    <Button Content="Открыть результаты"
                            Click="OpenOutput_OnClick"
                            Margin="0,0,7,0"
                            Padding="11,6"
                            Background="#334155"/>

                    <Button Content="Пример задачи"
                            Click="Example_OnClick"
                            Padding="11,6"
                            Background="#334155"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="8">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding StatusText}"
                           Margin="5,3,5,8"
                           TextWrapping="Wrap"
                           Foreground="#C9FBE6"/>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Steps}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          Background="Transparent"
                          BorderThickness="0"
                          Foreground="{StaticResource TextBrush}"
                          RowBackground="Transparent"
                          AlternatingRowBackground="#0E1728"
                          HorizontalGridLinesBrush="{StaticResource PanelBorderBrush}">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#"
                                            Binding="{Binding Id}"
                                            Width="0"/>

                        <DataGridTextColumn Header="Шаг"
                                            Binding="{Binding Title}"
                                            Width="180"/>

                        <DataGridTextColumn Header="Описание"
                                            Binding="{Binding Description}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Изменения"
                                            Binding="{Binding CreatesFiles}"
                                            Width="85"/>

                        <DataGridTextColumn Header="Статус"
                                            Binding="{Binding Status}"
                                            Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Background="#0B1220"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="8"
                Margin="0,10,0,0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Журнал workflow"
                           FontWeight="SemiBold"
                           Margin="4,2,4,5"/>

                <TextBox Grid.Row="1"
                         Text="{Binding LogText}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Background="Transparent"
                         Foreground="{StaticResource MutedTextBrush}"
                         BorderThickness="0"
                         FontFamily="Consolas"
                         FontSize="11"/>
            </Grid>
        </Border>

        <Border Grid.RowSpan="4"
                Background="#CC0B1020"
                CornerRadius="12"
                Visibility="{Binding BusyVisibility}">

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <ProgressBar IsIndeterminate="True"
                             Width="320"
                             Height="5"/>

                <TextBlock Text="Local Agent выполняет workflow…"
                           Margin="0,12,0,0"
                           FontWeight="SemiBold"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
