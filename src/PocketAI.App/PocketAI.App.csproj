<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>PocketAI</AssemblyName>
    <RootNamespace>PocketAI.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PocketAI.Core\PocketAI.Core.csproj" />
    <ProjectReference Include="..\PocketAI.Hardware\PocketAI.Hardware.csproj" />
    <ProjectReference Include="..\PocketAI.Inference\PocketAI.Inference.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\pocketai.json" Link="pocketai.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
